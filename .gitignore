.streamlit/secrets.toml
.env

# =========================
# Local Client Data & Reports (Prevent PII Leaks)
# =========================
# Ignore all raw text and JSON uploads
*.txt
*.json
# Ignore generated Word reports
*.docx

# Exceptions: Allow necessary project files to be committed
!requirements.txt
!templates/report_template.docx

